# Paper mode by default. Set to false only if you know what you're doing.
WEATHER_DRY_RUN=true
WEATHER_SCAN_INTERVAL_MINUTES=10

# Optional: Tomorrow.io nowcast for intraday checks
TOMORROW_API_KEY=

# Optional: Telegram alerts
TELEGRAM_BOT_TOKEN=
